{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar backend",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\iniciar.cmd",
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": {
          "regexp": "^\\[(ERROR)\\]\\s+(.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Iniciando Altura API",
          "endsPattern": "Started AlturaApplication"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
